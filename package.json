{
  "name": "frakitout-server-control-center",
  "version": "1.0.1",
  "description": "Native Windows control center for AzerothCore 3.3.5 servers",
  "main": "electron/main.js",
  "author": {
    "name": "FrakItOut",
    "url": "https://github.com/FreakItOut"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/FreakItOut/FrakItOut-Server-Control-Center.git"
  },
  "homepage": "https://github.com/FreakItOut/FrakItOut-Server-Control-Center#readme",
  "bugs": {
    "url": "https://github.com/FreakItOut/FrakItOut-Server-Control-Center/issues"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "pruefe": "node scripts/pruefe-alle.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && node scripts/winCodeSign-cache.js && electron-builder --win"
  },
  "dependencies": {
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.frakitout.servercontrol",
    "productName": "FrakItOut Server Control Center",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
